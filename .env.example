# Copy to .env and fill in real values. Never commit .env.

# --- Embedding API (OpenAI-compatible /embeddings endpoint, default: Volcengine Ark) ---
ARK_API_KEY=your-ark-api-key-here
EMBEDDING_API_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings
EMBEDDING_MODEL_NAME=doubao-embedding-text-240715
EMBEDDING_TIMEOUT_SECONDS=60

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:4b

# --- Milvus ---
# Either a Milvus server ...
MILVUS_HOST=localhost
MILVUS_PORT=19530
# ... or a URI. MILVUS_CONNECTION_URI wins when set (not MILVUS_URI: pymilvus reads that name itself and only accepts http URIs). A file path uses Milvus Lite (pip install milvus-lite).
# MILVUS_CONNECTION_URI=./milvus_lite.db
MILVUS_COLLECTION_NAME=rag_collection
# Must match the embedding model output size (doubao-embedding-text-240715: 2560).
MILVUS_DIMENSION=2560
MILVUS_METRIC_TYPE=L2
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_INDEX_PARAM_NLIST=128
MILVUS_SEARCH_PARAM_NPROBE=10
MILVUS_CONSISTENCY_LEVEL=Strong
MILVUS_SEARCH_MAX_DISTANCE=10000.0

# --- Text processing ---
# CHUNK_OVERLAP must be smaller than CHUNK_SIZE; invalid numbers stop the app at startup.
CHUNK_SIZE=200
CHUNK_OVERLAP=50

# --- Storage ---
SQLITE_DATABASE_URL=sqlite:///./rag_sqlite.db

# --- Server ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
SERVE_FRONTEND=true
# Auto-reload for `python -m backend.main` (same as --reload). Off unless 1/true/yes/on; development only.
SIMPLE_RAG_RELOAD=

# --- Security ---
# Optional. When set, /upload/ and /query/ require the header X-API-Key with this value.
# Required if you listen on a non-loopback address.
SIMPLE_RAG_API_KEY=
# Optional. The startup check detects the listen address for `python -m backend.main` and the uvicorn CLI.
# Under other launchers (gunicorn, custom uvicorn.run) set the address you bind here to enable the check.
SIMPLE_RAG_BIND_HOST=
# Comma-separated browser origins allowed by CORS. The bundled UI at / is same-origin.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Limits ---
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_BYTES=5242880
MAX_QUESTION_CHARS=4000
MAX_TOP_K=50
